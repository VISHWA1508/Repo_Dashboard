# Copy this file to ".env" and fill in your keys. Never commit ".env" to GitHub.

# Port the dashboard runs on
PORT=3000

# How often market data is re-fetched, in minutes (minimum 5)
REFRESH_MINUTES=15

# REQUIRED for Brent, US 10-yr yield, Fed funds and India 10-yr yield. Free, instant:
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# OPTIONAL: lets Gemini write the analyst note. Free tier, no card needed:
# https://aistudio.google.com/apikey
# Leave blank to use the built-in rule-based reasoning (also automatic).
GEMINI_API_KEY=
# Model name can change over time; check Google AI Studio for a current free-tier model.
GEMINI_MODEL=gemini-3.5-flash-lite
# Minimum minutes between Gemini calls (protects the free quota)
LLM_MIN_MINUTES=30

# Set to 1 to test the whole pipeline with fake market data (no keys, no internet needed)
MOCK_DATA=0
